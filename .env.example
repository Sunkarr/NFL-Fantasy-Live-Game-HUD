# NFL Fantasy Live Game HUD Configuration Example
# Copy this file to .env and configure your Sleeper or ESPN League

# Fantasy Platform: 'sleeper' or 'espn'
FANTASY_PLATFORM=sleeper

# Sleeper League Configuration (when FANTASY_PLATFORM=sleeper)
LEAGUE_ID=1390344846723543040

# ESPN Fantasy Configuration (when FANTASY_PLATFORM=espn)
ESPN_LEAGUE_ID=
# ESPN_SEASON & SEASON default automatically to the active NFL season if omitted
ESPN_SEASON=
# Only required if ESPN league is private:
ESPN_S2=
ESPN_SWID=

# General Configuration
TEAM_NAME=
HOST=0.0.0.0
PORT=8080
POLL_INTERVAL=5
TZ=Europe/Berlin
HIGHLIGHT_THRESHOLD=5.0
HIGHLIGHT_DISPLAY_SECONDS=6
SEASON=
